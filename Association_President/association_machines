        document.querySelectorAll('.machine-row').forEach(r => {
            if (r.dataset.id == '<?= (int)($_POST['machine_id'] ?? 0) ?>') { r.click(); openEditModal(); }
        });
    <?php endif; ?>
});
<?php endif; ?>
