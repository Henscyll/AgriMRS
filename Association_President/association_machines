<?php
session_start();
require_once '../includes/db_connection.php';
include('dashboard_president.php');

if (!isset($_SESSION['association_id'])) {
    header("Location: ../login.php");
    exit;
}
$association_id = $_SESSION['association_id'];

$message = "";
$error   = "";

/* ===============================
   UPDATE PRICING
================================ */
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST['update_pricing'])) {
    $machine_id        = $_POST['machine_id'];
    $price_per_hectare = $_POST['price_per_hectare'];
    if ($price_per_hectare < 0) {
        $error = "Price cannot be negative.";
    } else {
        $stmt = $conn->prepare("UPDATE machines SET price_per_hectare = ? WHERE id = ? AND association_id = ?");
        $stmt->bind_param("dii", $price_per_hectare, $machine_id, $association_id);
        if ($stmt->execute()) $message = "Pricing updated successfully!";
        else $error = "Failed to update pricing.";
        $stmt->close();
    }
}

/* ===============================
   ASSIGN OPERATOR
================================ */
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST['assign_operator'])) {
    $machine_id  = $_POST['machine_id'];
    $operator_id = $_POST['operator_id'];
    $check = $conn->prepare("SELECT id FROM machine_operators WHERE machine_id = ? AND operator_id = ? AND status = 'Active'");
    $check->bind_param("ii", $machine_id, $operator_id);
    $check->execute();
    $res = $check->get_result();
    if ($res->num_rows > 0) {
        $error = "Operator already assigned to this machine.";
    } else {
        $stmt = $conn->prepare("INSERT INTO machine_operators (machine_id, operator_id, status) VALUES (?, ?, 'Active')");
        $stmt->bind_param("ii", $machine_id, $operator_id);
        $stmt->execute();
        $message = "Operator assigned successfully!";
        $stmt->close();
    }
    $check->close();
}

/* ===============================
   UNASSIGN OPERATOR
================================ */
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST['unassign_operator'])) {
    $machine_id  = (int)$_POST['machine_id'];
    $operator_id = (int)$_POST['operator_id'];
    $verify = $conn->prepare("
        SELECT mo.id FROM machine_operators mo
        INNER JOIN machines m ON mo.machine_id = m.id
        WHERE mo.machine_id = ? AND mo.operator_id = ? AND m.association_id = ? AND mo.status = 'Active'
    ");
    $verify->bind_param("iii", $machine_id, $operator_id, $association_id);
    $verify->execute();
    if ($verify->get_result()->num_rows > 0) {
        $stmt = $conn->prepare("UPDATE machine_operators SET status = 'Inactive' WHERE machine_id = ? AND operator_id = ?");
        $stmt->bind_param("ii", $machine_id, $operator_id);
        if ($stmt->execute()) $message = "Operator unassigned successfully!";
        else $error = "Failed to unassign operator.";
        $stmt->close();
    } else {
        $error = "Assignment not found or unauthorized.";
    }
    $verify->close();
}

/* ===============================
   EDIT MACHINE — status only
================================ */
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST['edit_machine'])) {
    $machine_id = (int)$_POST['machine_id'];
    $status     = $_POST['status'];

    $allowed = ['Active', 'Inactive', 'Under Maintenance'];
    if (!in_array($status, $allowed)) {
        $error = "Invalid status value.";
    } else {
        $stmt = $conn->prepare("UPDATE machines SET status = ? WHERE id = ? AND association_id = ?");
        $stmt->bind_param("sii", $status, $machine_id, $association_id);
        if ($stmt->execute()) $message = "Machine status updated successfully!";
        else $error = "Failed to update machine.";
        $stmt->close();
    }
}

/* ===============================
   FETCH MACHINES
================================ */
$search_field  = $_GET['search_field']   ?? 'All';
$search_term   = $_GET['search_term']    ?? '';
$status_filter = $_GET['statusDropdown'] ?? '';
$date_from     = $_GET['date_from']      ?? '';
$date_to       = $_GET['date_to']        ?? '';
$field_changed = $_GET['field_changed']  ?? '0';

$where_parts = ["m.association_id = ?"];

if ($field_changed !== '1' && !empty($search_term)) {
    if ($search_field === 'machine_name') {
        $where_parts[] = "m.machine_name LIKE '%" . $conn->real_escape_string($search_term) . "%'";
    } elseif ($search_field === 'type') {
        $where_parts[] = "m.type = '" . $conn->real_escape_string($search_term) . "'";
    }
}
if ($search_field === 'Status' && $field_changed !== '1') {
    if (!empty($status_filter))
        $where_parts[] = "m.status = '" . $conn->real_escape_string($status_filter) . "'";
    if (!empty($date_from))
        $where_parts[] = "DATE(m.created_at) >= '" . $conn->real_escape_string($date_from) . "'";
    if (!empty($date_to))
        $where_parts[] = "DATE(m.created_at) <= '" . $conn->real_escape_string($date_to) . "'";
}
$where_sql = "WHERE " . implode(" AND ", $where_parts);

$machines_sql = "
    SELECT m.*,
        DATE_FORMAT(m.created_at, '%m/%d/%Y') AS assigned_at_fmt,
        GROUP_CONCAT(CONCAT(o.name) SEPARATOR ', ') AS assigned_operators
    FROM machines m
    LEFT JOIN machine_operators mo ON m.id = mo.machine_id AND mo.status = 'Active'
    LEFT JOIN operators o ON mo.operator_id = o.id
    $where_sql
    GROUP BY m.id
    ORDER BY m.created_at DESC
";
$stmt = $conn->prepare($machines_sql);
$stmt->bind_param("i", $association_id);
$stmt->execute();
$result   = $stmt->get_result();
$machines = [];
while ($row = $result->fetch_assoc()) $machines[] = $row;
$stmt->close();

/* Operators for assign dropdown */
$op_stmt = $conn->prepare("SELECT * FROM operators WHERE association_id = ? AND status = 'Active' ORDER BY name");
$op_stmt->bind_param("i", $association_id);
$op_stmt->execute();
$operators_result = $op_stmt->get_result();
$operators = [];
while ($op = $operators_result->fetch_assoc()) $operators[] = $op;
$op_stmt->close();

/* Assigned operators per machine */
$assigned_sql = "
    SELECT mo.machine_id, mo.operator_id, o.name AS operator_name, o.phone
    FROM machine_operators mo
    INNER JOIN operators o ON mo.operator_id = o.id
    INNER JOIN machines m  ON mo.machine_id  = m.id
    WHERE m.association_id = ? AND mo.status = 'Active'
    ORDER BY o.name
";
$as_stmt = $conn->prepare($assigned_sql);
$as_stmt->bind_param("i", $association_id);
$as_stmt->execute();
$as_result = $as_stmt->get_result();
$assigned_by_machine = [];
while ($row = $as_result->fetch_assoc())
    $assigned_by_machine[$row['machine_id']][] = $row;
$as_stmt->close();
?>
