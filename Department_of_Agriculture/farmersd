<?php
include('da_header.php');    
require_once '../includes/config.php';

// Pagination setup
$limit = 10; 
$page = isset($_GET['page']) && is_numeric($_GET['page']) ? intval($_GET['page']) : 1;
$offset = ($page - 1) * $limit;

// Search setup
$searchTerm = '';
$where = '';
$searchField = 'name';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['search_term'])) {
    $searchTerm = trim($_POST['search_term']);
    $searchField = $_POST['search_field'] ?? 'name';

    $safe = $conn->real_escape_string($searchTerm);
    switch ($searchField) {
        case 'name':
            $where = "WHERE name LIKE '%$safe%'";
            break;
        case 'email':
            $where = "WHERE email LIKE '%$safe%'";
            break;
        case 'municipality':
            $where = "WHERE municipality LIKE '%$safe%'";
            break;
    }
}

// Count total farmers
$count_sql = "SELECT COUNT(*) AS total FROM farmers $where";
$count_result = $conn->query($count_sql);
$total_records = $count_result->fetch_assoc()['total'] ?? 0;
$total_pages = max(1, ceil($total_records / $limit));

// Fetch farmers
$sql = "SELECT id, name AS full_name, email, phone, farm_size, region, province, municipality, barangay, status 
        FROM farmers $where 
        LIMIT $limit OFFSET $offset";
$result = $conn->query($sql);
?>

